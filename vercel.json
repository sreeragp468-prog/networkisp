{
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.js" },
    { "source": "/", "destination": "/frontent/table.html" },
    { "source": "/table.html", "destination": "/frontent/table.html" },
    { "source": "/app.html", "destination": "/frontent/app.html" },
    { "source": "/app.js", "destination": "/frontent/app.js" }
  ]
}
